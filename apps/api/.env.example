NODE_ENV=development
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app
DATABASE_USERNAME=app
DATABASE_PASSWORD=app
DATABASE_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=app
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
REDIS_TLS=false
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=app-api
JWT_AUDIENCE=app-cms
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
QUEUE_MONITOR_USERNAME=change-me
QUEUE_MONITOR_PASSWORD=change-me-queue-monitor
DEFAULT_USER_PASSWORD=change-me-user-password
CORS_ORIGINS=http://localhost:5173
# Canonical frontend base URL for auth email links; required when EMAIL_ENABLED=true.
PUBLIC_APP_URL=http://localhost:5173
EMAIL_ENABLED=false
# Required in production when EMAIL_ENABLED=true; exactly 64 hexadecimal characters.
# EMAIL_DELIVERY_ENCRYPTION_KEY=
