server {
    listen 80;
    listen [::]:80;
    server_name safial-cms.dctrl.my.id;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name safial-cms.dctrl.my.id;

    root /root/projects/safial_cms/apps/cms/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/safial-api.dctrl.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/safial-api.dctrl.my.id/privkey.pem;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
